{
  "name": "cubelink-studio-unified",
  "version": "4.1.8",
  "description": "Unified CubeLink robot arm and conveyor studio by Eoreum",
  "main": "main.js",
  "author": "Eoreum",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "test": "node --test ../../../test/studio-unified-launcher.test.cjs"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.eoreum.cubelinkstudio.unified",
    "productName": "CubeLink Studio",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "serialControllers.js", "protocol.js", "driverSupport.js", "package.json"],
    "extraResources": [
      { "from": "../launcher", "to": "launcher", "filter": ["**/*"] },
      { "from": "../../desktop-v4/web", "to": "arm-web", "filter": ["**/*", "!**/*.bak", "!**/*.backup*", "!**/*.broken", "!**/*.tmp"] },
      { "from": "../../conveyor-desktop-v0.12/web", "to": "conveyor-web", "filter": ["**/*"] },
      { "from": "../../conveyor-desktop-v0.12/firmware", "to": "conveyor-firmware", "filter": ["**/*"] },
      { "from": "../../desktop-v4/electron/factoryNetwork.js", "to": "shared/factoryNetwork.js" },
      { "from": "../../electron/drivers/CH341SER/CH341SER", "to": "drivers/CH341SER", "filter": ["CH341SER.INF", "CH341SER.CAT", "*.sys", "*.SYS", "*.dll", "*.DLL"] }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "../../desktop-v4/electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CubeLink Studio",
      "include": "../../desktop-v4/electron/installer.nsh",
      "artifactName": "CubeLink_Studio_v${version}_Unified_Setup.${ext}"
    },
    "portable": {
      "artifactName": "CubeLink_Studio_v${version}_Unified_Portable.${ext}"
    }
  }
}
